{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@crate/types": ["./packages/types/src/index.ts"],
      "@crate/utils": ["./packages/utils/src/index.ts"],
      "@crate/web": ["./packages/web/src"]
    },
    "resolvePackageJsonExports": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022"
  }
}
