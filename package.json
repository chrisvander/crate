{
  "name": "root",
  "author": "Christian van der Loo",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@jscutlery/semver": "^2.25.2",
    "@nrwl/express": "15.0.7",
    "@nrwl/jest": "15.0.7",
    "@nrwl/js": "15.0.7",
    "@nrwl/node": "15.0.7",
    "@nrwl/nx-cloud": "15.0.1",
    "@nrwl/react": "15.0.7",
    "@nx-tools/docker-metadata": "^3.0.0",
    "@nx-tools/nx-docker": "^3.0.0",
    "@nxext/vite": "^14.0.0",
    "@openapitools/openapi-generator-cli": "2.5.2",
    "@trumbitta/nx-plugin-openapi": "^1.11.0",
    "@types/express": "4.17.14",
    "@types/jest": "29.1.2",
    "@types/node": "26.4.0",
    "esbuild": "^0.15.7",
    "husky": "^8.0.0",
    "jest": "29.1.2",
    "lint-staged": "^13.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "ts-jest": "29.0.3",
    "ts-node": "~10.9.1",
    "typescript": "7.0.2",
    "vite": "^3.1.7"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "**/*.{tsx,ts,jsx,js}": [
      "oxfmt",
      "oxlint --deny-warnings",
      "nx affected:test --uncommitted"
    ]
  },
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:web": "nx build @crate/web",
    "build:since": "nx affected --target=build",
    "test:all": "nx run-many --target=test --all",
    "test:web": "nx test @crate/web",
    "test:since": "nx affected --target=test",
    "typecheck": "tsc -p packages/types && tsc -p packages/utils && tsc -p packages/server && tsc -p packages/web",
    "dev": "nx run-many --target=serve --all",
    "dev:web": "nx dev @crate/web",
    "docker": "nx run-many --target=docker --all",
    "docs": "nx run-many --target=generate-sources --all && nx run @crate/types:build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@nrwl/esbuild": "^15.0.7",
    "@nxrs/cargo": "^0.3.3",
    "@wanews/nx-esbuild": "^0.26.1",
    "ipfs-utils": "9.0.7",
    "jest-environment-jsdom": "^29.1.2",
    "node-fetch": "3.2.10",
    "patch-package": "^6.4.7",
    "postinstall-postinstall": "^2.1.0",
    "tslib": "^2.3.0"
  },
  "version": "0.1.0"
}
