{
  "name": "root",
  "author": "Christian van der Loo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.5.2",
    "@types/express": "4.17.14",
    "@types/node": "26.4.0",
    "esbuild": "^0.15.7",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:server && bun run build:web",
    "build:server": "bun run --filter @crate/server build",
    "build:web": "bun run --filter @crate/web build",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json",
    "dev": "bun run dev:web",
    "dev:web": "bun run --filter @crate/web dev",
    "docs": "openapi-generator-cli generate -i packages/api-spec/src/crate-spec.openapi.yml -g html -o packages/api-docs/src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "ipfs-utils": "9.0.7",
    "node-fetch": "3.2.10",
    "patch-package": "^6.4.7",
    "tslib": "^2.3.0"
  },
  "version": "0.1.0"
}
