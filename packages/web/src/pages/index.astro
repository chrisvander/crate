---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Your files">
  <section class="hero panel">
    <p class="eyebrow">An ATProto-native drive</p>
    <h1>Your files.<br />Your account.</h1>
    <p>Store files in your personal data server and access them with Crate.</p>
    <p>
      Your PDS controls storage and access. Crate does not add a separate
      account or storage subscription.
    </p>
    <a class="button" href="/files">Open your files</a>
  </section>
</Layout>
