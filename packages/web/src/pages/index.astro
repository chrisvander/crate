---
import Layout from "../layouts/Layout.astro";
import { PublicNavigation } from "../components/PublicNavigation";
import { HeroBackdrop } from "../components/HeroBackdrop";
import "../styles/landing.css";
---

<Layout title="Crate" navigation={false}>
  <div class="landing-page">
    <PublicNavigation client:load />
    <section class="hero-frame">
      <HeroBackdrop client:load />
      <div class="hero-content">
        <h1>Cloud storage, <span>reimagined.</span></h1>
        <p>
          Store your files in your own personal data server. Access them across
          clients with your ATProto account. Your PDS controls storage and
          permissions. Crate requires private Spaces support, so choose a
          compatible PDS to keep your files private.
        </p>
        <div class="hero-actions">
          <a class="hero-primary" href="/login">Log in</a>
          <a class="hero-secondary" href="/files">Open files</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
